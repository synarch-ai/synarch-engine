# Synarch Web — Environment Variables
# Copy to apps/web/.env.local

# Base URL for REST calls from Mission Control
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL for SSE mission/event stream
NEXT_PUBLIC_SSE_BASE_URL=http://localhost:8000

# Feature flag for live stream panels (optional)
NEXT_PUBLIC_ENABLE_MISSION_STREAM=true
