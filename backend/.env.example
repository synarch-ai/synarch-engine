# Synarch Engine — Environment Variables
# Copy to .env.local (recommended) or .env and fill in your values.
# backend/config.py loads .env.local first, then .env.

# --- Database ---
DATABASE_URL=postgresql://synarch:synarch_local@localhost:5433/synarch

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Ollama ---
OLLAMA_API_BASE=http://localhost:11434

# --- AWS Bedrock ---
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Model Routing Overrides (Optional) ---
MODEL_SYNARCH=bedrock/anthropic.claude-opus-4-20250514-v1:0
MODEL_ZEUS=bedrock/anthropic.claude-sonnet-4-20250514-v1:0
MODEL_THOTH=bedrock/anthropic.claude-sonnet-4-20250514-v1:0
MODEL_HERMES=ollama/llama3.1:8b
MODEL_HEPHAESTUS=bedrock/anthropic.claude-sonnet-4-20250514-v1:0
MODEL_JANUS=bedrock/anthropic.claude-3-5-haiku-20241022-v1:0

# --- App ---
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- HITL ---
APPROVAL_TIMEOUT_SECONDS=300
DEFAULT_AUTHORITY_MODE=supervised
